{
  "compilerOptions": {
    "target": "ES2022",
    // No `DOM` and no `node` types: both runtimes use this package, so it may
    // depend on nothing beyond the language. The zone maths rides on `Intl`,
    // which is part of ES2022 and present in the browser and in node alike.
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["vitest/globals"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,

    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src", "vitest.config.ts"]
}
