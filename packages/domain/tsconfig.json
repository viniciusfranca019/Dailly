{
  "compilerOptions": {
    "target": "ES2022",
    // No `DOM` and no `node` types, for the same reason as whiteboard-core and
    // one more: these use-cases run in the renderer (see `src/index.ts`), so a
    // `node:` import here would not just be a layering smell — it would not run.
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["vitest/globals"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,

    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src", "vitest.config.ts"]
}
